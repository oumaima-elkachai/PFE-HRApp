# Copie ce fichier vers .env et remplis les valeurs.
# .env ne doit JAMAIS être versionné : il contient des mots de passe.

# L'URL de ton API, sans barre oblique finale.
# Visible dans le récapitulatif de ta dernière livraison GitHub Actions,
# ou avec :
#   aws cloudformation describe-stacks --stack-name PfeRh-dev-Api \
#     --query "Stacks[0].Outputs[?OutputKey=='UrlApi'].OutputValue" --output text
URL_API=https://xxxxxxxxxx.execute-api.eu-west-3.amazonaws.com

AWS_REGION=eu-west-3

# L'identifiant du client Cognito (le même que VITE_COGNITO_CLIENT_ID).
COGNITO_CLIENT_ID=

# "id" si ton autorisateur valide le jeton d'identité (cas habituel),
# "access" s'il valide le jeton d'accès.
TYPE_JETON=id

# Trois comptes de test, un par rôle.
# Utilise des comptes dédiés aux tests, pas tes comptes personnels.
RH_UTILISATEUR=rh.test@octopusplus.tn
RH_MOTDEPASSE=

SALARIE_UTILISATEUR=a.bensalah@octopusplus.tn
SALARIE_MOTDEPASSE=

CANDIDAT_UTILISATEUR=yassine.khelifi@gmail.com
CANDIDAT_MOTDEPASSE=
